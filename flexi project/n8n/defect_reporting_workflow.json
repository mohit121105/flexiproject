{
  "name": "AI-Based Defect Reporting — n8n Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "defect-report",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook — Receive Defect",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "defect-report-webhook"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst body = data.body || data;\n\nreturn [{\n  json: {\n    session_id: body.session_id || 'N/A',\n    title: body.title || 'Untitled Defect',\n    description: body.description || '',\n    component: body.component || 'Unknown',\n    severity: body.severity || 'Medium',\n    reporter: body.reporter || 'AI System',\n    timestamp: body.timestamp || new Date().toISOString(),\n    report_markdown: body.report_markdown || '',\n    severity_color: {\n      'Critical': '🔴',\n      'High': '🟠', \n      'Medium': '🟡',\n      'Low': '🟢'\n    }[body.severity] || '⚪'\n  }\n}];"
      },
      "id": "parse-data",
      "name": "Parse & Enrich Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Defects",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Session ID": "={{ $json.session_id }}",
            "Title": "={{ $json.title }}",
            "Component": "={{ $json.component }}",
            "Severity": "={{ $json.severity_color }} {{ $json.severity }}",
            "Reporter": "={{ $json.reporter }}",
            "Timestamp": "={{ $json.timestamp }}",
            "Status": "Open",
            "Description": "={{ $json.description.substring(0, 500) }}"
          }
        },
        "options": {}
      },
      "id": "google-sheets",
      "name": "Log to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [680, 200]
    },
    {
      "parameters": {
        "sendTo": "qa-team@yourcompany.com",
        "subject": "={{ $json.severity_color }} [{{ $json.severity }}] Defect: {{ $json.title }}",
        "message": "=<!DOCTYPE html><html><body style='font-family: Arial, sans-serif; max-width: 600px;'>\n<div style='background: #2c3e50; color: white; padding: 20px; border-radius: 8px 8px 0 0;'>\n  <h2>🐛 Defect Report — AI Defect Reporting System</h2>\n</div>\n<div style='background: #f8f9fa; padding: 20px; border-radius: 0 0 8px 8px;'>\n  <table style='width: 100%; border-collapse: collapse;'>\n    <tr><td style='padding: 8px; font-weight: bold; color: #555;'>Defect ID:</td><td style='padding: 8px;'>{{ $json.session_id }}</td></tr>\n    <tr style='background: white;'><td style='padding: 8px; font-weight: bold; color: #555;'>Severity:</td><td style='padding: 8px;'><strong>{{ $json.severity_color }} {{ $json.severity }}</strong></td></tr>\n    <tr><td style='padding: 8px; font-weight: bold; color: #555;'>Component:</td><td style='padding: 8px;'>{{ $json.component }}</td></tr>\n    <tr style='background: white;'><td style='padding: 8px; font-weight: bold; color: #555;'>Reporter:</td><td style='padding: 8px;'>{{ $json.reporter }}</td></tr>\n    <tr><td style='padding: 8px; font-weight: bold; color: #555;'>Timestamp:</td><td style='padding: 8px;'>{{ $json.timestamp }}</td></tr>\n  </table>\n  <div style='margin-top: 20px;'>\n    <h3 style='color: #2c3e50;'>Description</h3>\n    <p style='background: white; padding: 15px; border-radius: 4px; border-left: 4px solid #e74c3c;'>{{ $json.description }}</p>\n  </div>\n  <p style='color: #7f8c8d; font-size: 12px; margin-top: 20px;'>Generated by AI-Based Defect Reporting System</p>\n</div>\n</body></html>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "gmail-notify",
      "name": "Email QA Team (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [680, 380]
    },
    {
      "parameters": {
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "list"
        },
        "title": "={{ $json.severity_color }} Defect Review: {{ $json.title }}",
        "start": "={{ $now.plus({days: 1}).startOf('day').plus({hours: 10}).toISO() }}",
        "end": "={{ $now.plus({days: 1}).startOf('day').plus({hours: 11}).toISO() }}",
        "additionalFields": {
          "description": "=Defect Review Meeting\n\nTitle: {{ $json.title }}\nComponent: {{ $json.component }}\nSeverity: {{ $json.severity }}\nReporter: {{ $json.reporter }}\n\nDescription:\n{{ $json.description }}\n\nGenerated by AI Defect Reporting System",
          "location": "Google Meet (auto-generated)"
        }
      },
      "id": "google-calendar",
      "name": "Create Calendar Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [680, 560]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({success: true, message: 'Defect report processed', session_id: $('Parse & Enrich Data').item.json.session_id, actions: ['logged_to_sheets', 'email_sent', 'calendar_created']}) }}"
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [900, 380]
    }
  ],
  "connections": {
    "Webhook — Receive Defect": {
      "main": [
        [{"node": "Parse & Enrich Data", "type": "main", "index": 0}]
      ]
    },
    "Parse & Enrich Data": {
      "main": [
        [
          {"node": "Log to Google Sheets", "type": "main", "index": 0},
          {"node": "Email QA Team (Gmail)", "type": "main", "index": 0},
          {"node": "Create Calendar Event", "type": "main", "index": 0}
        ]
      ]
    },
    "Email QA Team (Gmail)": {
      "main": [
        [{"node": "Respond to Webhook", "type": "main", "index": 0}]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {"id": "agentic-ai-course", "name": "Agentic AI & Automation"}
  ],
  "triggerCount": 1,
  "updatedAt": "2026-09-19T06:00:00.000Z",
  "versionId": "1"
}
